nota = float(input("Diga a nota do aluno: "))
freq = float(input("Diga a frequencia em porcentagem (apenas o valor numerico) do aluno: "))

if nota >= 7.0 and freq >= 75:
    print("O aluno está aprovado!")
elif nota < 7.0 and freq >= 75:
    print("O aluno foi reprovado por nota!")
elif nota >= 7.0 and freq < 75:
    print("O aluno foi reprovado por frequencia!")
else:
    print("O aluno está reprovado!")

